    {
      "id": "efd345ee-8a03-465a-b369-5cf01676c971",
      "name": "Files",
      "description": {
        "content": "Upload, download, list, and delete files in the personal, shared, or models space within SingleStore Helios Spaces (stage storage).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b0deba18-47cf-4556-93f4-b37c83364899",
          "name": "Get or List Stage File",
          "request": {
            "name": "Get or List Stage File",
            "description": {
              "content": "Retrieves a file from the stage filesystem at the specified path, or lists directory contents when the path points to a directory. Use the metadata query parameter to return object metadata instead of file content.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stage",
                ":deploymentID",
                "fs",
                ":stagePath"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "metadata",
                  "value": "<integer>",
                  "description": "When set to 1, returns file metadata (size, type, modified date) instead of file content."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "deploymentID",
                  "description": "(Required) Unique deployment identifier associated with a workspace group, used to address the stage filesystem."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "stagePath",
                  "description": "(Required) File or directory path within the stage filesystem."
                },
                {
                  "description": "Hostname of the SingleStore Helios workspace to query. Obtain this value from the workspace endpoint field in the Cloud Portal or via the Management API.",
                  "type": "any",
                  "value": "{{workspaceHost}}",
                  "key": "workspaceHost"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {

{
  "opencollection": "1.0.0",
  "info": {
    "name": "SingleStore Data Files Secrets API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Secrets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{workspaceHost}/secrets",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter secrets by exact name match."
              }
            ]
          },
          "docs": "Retrieves all secrets defined in the current organization, optionally filtered by name. Secret values are not returned in list responses; only metadata such as name, ID, and timestamps are included."
        }
      ]
    }
  ],
  "bundled": true
}